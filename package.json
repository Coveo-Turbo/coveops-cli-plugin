{
  "name": "coveops-cli-plugin",
  "description": "A new CLI generated with oclif",
  "version": "0.7.1",
  "contributors": [
    {
      "name": "Jantoun_coveo",
      "email": "jantoun@coveo.com"
    },
    {
      "name": "Jean-François Allaire",
      "email": "jfallaire@coveo.com"
    }
  ],
  "bin": {
    "coveops": "./bin/run.js"
  },
  "bugs": "https://github.com/Coveo-Turbo/coveops-cli-plugin/issues",
  "dependencies": {
    "@coveo/cli-commons": "^2.9.4",
    "@coveo/platform-client": "^57.12.0",
    "@coveops/commerce-troubleshoot-deployer": "^0.1.2",
    "@oclif/core": "1.24.0",
    "@oclif/plugin-help": "5.1.23",
    "@oclif/plugin-plugins": "2.1.12",
    "tslib": "2.5.0"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "2.2.21",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^8",
    "eslint-config-oclif": "^5",
    "eslint-config-oclif-typescript": "^3",
    "eslint-config-prettier": "^9",
    "mocha": "^10",
    "oclif": "3.4.3",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/Coveo-Turbo/coveops-cli-plugin",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "coveops",
    "dirname": "coveops",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "org:search:authentication": {
        "description": "manage your authentication providers for an organization"
      },
      "org:vaults": {
        "description": "manage your organization vaults"
      },
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": "Coveo-Turbo/coveops-cli-plugin",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint . --ext .ts",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
